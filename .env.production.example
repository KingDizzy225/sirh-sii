# ==============================================================================
# Configuration d'Environnement de Production — SIRH-SII
# ==============================================================================

# Port d'écoute du serveur d'application
PORT=3000
NODE_ENV=production

# Base de Données PostgreSQL
DATABASE_URL=postgresql://sii_admin:SuperSecretPassword2026!@localhost:5432/sirh_sii?schema=public

# Clé de signature JWT pour sessions RH et Tokens collaborateurs
JWT_SECRET=CleSecreteTresLongueEtSecuriseePourLaPlateformeSIRH_SII_2026

# Paramètres Entreprise & Conformité Ivoirienne
COMPANY_NAME=SII Côte d'Ivoire
COMPANY_LOGO_PATH=/logo.png
COMPANY_HEADQUARTERS=Abidjan Plateau, Rue du Commerce
CNPS_EMPLOYER_ID=0045892-CI
TAX_REGIME=Régime Réel Normal (DGI Côte d'Ivoire)
CURRENCY=XOF

# Intégrations Optionnelles
SMTP_HOST=smtp.sii-ci.com
SMTP_PORT=587
SMTP_USER=notifications-rh@sii-ci.com
SMTP_PASS=MotDePasseMessagerie
WHATSAPP_GATEWAY_URL=http://localhost:3000/api/whatsapp-gateway
