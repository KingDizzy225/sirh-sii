# ========================================
# SIRH-SII Frontend — Variables d'environnement (Vite)
# Copier ce fichier en .env.local et adapter les valeurs
# ========================================

# URL du backend (sans /api final)
VITE_API_URL="https://sirh-backend-dbtv.onrender.com"

# Mode démonstration — ACTIF PAR DÉFAUT pendant la phase de démonstration.
# Dans cet état, l'application ouvre une session Administrateur sans
# authentification et affiche des données fictives, signalées par un bandeau
# orange permanent.
#
# AVANT LA MISE EN PRODUCTION AVEC DE VRAIES DONNÉES RH, définir :
#   VITE_DEMO_MODE="false"
# L'écran de connexion devient alors obligatoire et les mots de passe sont
# réellement vérifiés. Créer au préalable un compte avec `npm run create-admin`
# côté serveur, sans quoi plus personne ne pourra se connecter.
VITE_DEMO_MODE="true"
