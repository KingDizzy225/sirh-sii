# ========================================
# SIRH-SII Frontend — Variables d'environnement (Vite)
# Copier ce fichier en .env.local et adapter les valeurs
# ========================================

# URL du backend (sans /api final)
VITE_API_URL="https://sirh-backend-dbtv.onrender.com"

# Mode démonstration — NE JAMAIS ACTIVER EN PRODUCTION.
# À "true", l'application ouvre une session Administrateur sans authentification
# et affiche des données fictives, signalées par un bandeau orange permanent.
# Toute autre valeur (ou l'absence de variable) impose une connexion réelle.
VITE_DEMO_MODE="false"
