# ========================================
# SIRH-SII Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ========================================

# ---------- Indispensable ----------

PORT=3000
NODE_ENV=production

# Base de données PostgreSQL. Sur Render, utiliser l'URL *interne* pour le
# service web, l'URL *externe* pour se connecter depuis un poste.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Signature des jetons de session. 32 caractères minimum : en production, le
# serveur refuse de démarrer en deçà. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"

# Adresse du frontend. Sert à deux choses : restreindre les origines acceptées
# par l'API (sans elle, CORS accepte tout le monde) et construire les liens des
# emails et des QR codes de pointage.
FRONTEND_URL="https://sirh-sii.vercel.app"

# ---------- Comptes ----------

# Les comptes de démonstration (@sirh.com, mot de passe annoncé sur l'écran de
# connexion) sont recréés à chaque démarrage. Poser "true" AVANT d'ouvrir
# l'application à de vrais salariés, et créer d'abord un compte nominatif —
# sans quoi plus personne ne peut se connecter.
DISABLE_TEST_ACCOUNTS=

# Création du premier administrateur au démarrage, sans accès à la base.
# Le compte n'est jamais écrasé s'il existe déjà. Retirer le mot de passe des
# variables une fois le compte créé.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ---------- Intelligence artificielle ----------

# Claude (Anthropic) — alimente le chatbot, l'extraction de documents,
# les fiches de poste, le sourcing et les analyses.
ANTHROPIC_API_KEY=""

# Requis si votre clé n'est pas rattachée à un espace de travail : l'API la
# refuse alors avec « This API key is not scoped to a workspace ». L'identifiant
# se lit dans la console Anthropic, dans l'URL de l'espace de travail.
ANTHROPIC_WORKSPACE_ID=

# Facultatif : modèle et niveau d'effort.
# ANTHROPIC_MODEL="claude-opus-5"
# ANTHROPIC_EFFORT="medium"   # low | medium | high | xhigh | max

# ---------- Guichet WhatsApp ----------

# Permet aux salariés d'interroger le SIRH depuis WhatsApp (!solde, !paie,
# !conge). Sans ces variables, la logique reste accessible en simulation depuis
# l'écran RH, mais aucun salarié ne peut l'atteindre.
#
# Les quatre valeurs viennent de l'application Meta (developers.facebook.com) :
#   TOKEN            jeton d'accès permanent
#   PHONE_NUMBER_ID  identifiant du numéro expéditeur
#   VERIFY_TOKEN     chaîne de votre choix, redonnée à Meta à l'abonnement
#   APP_SECRET       secret de l'application ; sert à vérifier que les messages
#                    viennent bien de Meta. Sans lui, l'adresse du webhook étant
#                    publique, n'importe qui pourrait poser un congé au nom d'un
#                    salarié dont il connaît le numéro : la réception est donc
#                    refusée tant qu'il est absent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION="v21.0"

# Adresse publique de l'API, à coller comme webhook dans la console Meta.
# Renseignée automatiquement sur Render (RENDER_EXTERNAL_URL) ; à déclarer
# ailleurs. Ce n'est pas FRONTEND_URL : un webhook pointé sur le site
# n'atteindrait aucune route de l'API.
PUBLIC_API_URL=

# ---------- Congés ----------

# Barèmes du calcul des droits. Valeurs par défaut : Code du travail ivoirien et
# convention collective interprofessionnelle. À vérifier contre la convention
# applicable à votre branche, qui peut être plus favorable.
# LEAVE_ACCRUAL_DAYS_PER_MONTH="2.2"   # acquisition mensuelle (art. 25.1)
# LEAVE_MAX_BALANCE="60"               # plafond de cumul
# LEAVE_SENIORITY_SCALE="5:1,10:2,15:3,20:4,25:5,30:6"  # années:jours
# LEAVE_DAYS_PER_CHILD="2"             # par enfant à charge de moins de 14 ans
# LEAVE_CHILD_BONUS_GENDER="F"         # F | M | TOUS
# LEAVE_REFERENCE_YEAR_START="ANNIVERSAIRE"  # ou une date fixe, ex. "01-01"

# ---------- Budget ----------

# Nombre minimal de mois de paie renseignés avant qu'une projection annuelle
# soit calculée. En deçà, extrapoler l'année donnerait un chiffre plus trompeur
# qu'utile : un seul mois multiplié par douze n'est pas une prévision.
# BUDGET_MOIS_MIN_PROJECTION="3"

# ---------- Sous-traitance ----------

# Durées de validité usuelles des attestations, en mois, et préavis d'alerte en
# jours. Servent à déduire une échéance quand la pièce n'en porte pas, et à
# relancer avant expiration. Une attestation périmée vaut une attestation
# absente : le donneur d'ordre répond des salariés non déclarés par son
# prestataire.
# SOUS_TRAITANCE_PREAVIS_JOURS="30"
# SOUS_TRAITANCE_VALIDITE_CNPS_MOIS="3"
# SOUS_TRAITANCE_VALIDITE_FISCAL_MOIS="3"
# SOUS_TRAITANCE_VALIDITE_RCCM_MOIS="12"
# SOUS_TRAITANCE_VALIDITE_ASSURANCE_MOIS="12"
# SOUS_TRAITANCE_VALIDITE_PERSONNEL_MOIS="6"

# ---------- Procédures disciplinaires ----------

# Délais de la procédure interne, en jours. Ce sont des valeurs par défaut, non
# des certitudes : le Code du travail ivoirien et les conventions collectives ne
# fixent pas tous les mêmes durées, et une convention de branche peut être plus
# protectrice. L'application n'impose que ce que l'entreprise s'est donné.
# PROCEDURE_DELAI_ENTRETIEN_JOURS="2"     # entre la convocation et l'entretien
# PROCEDURE_DELAI_EXPLICATION_JOURS="2"   # laissé au salarié pour s'expliquer
# PROCEDURE_DELAI_NOTIFICATION_JOURS="15" # au-delà, l'étape est signalée en retard

# ---------- Corbeille ----------

# Durée pendant laquelle un dossier salarié supprimé reste restaurable. Au-delà,
# il est purgé définitivement : la corbeille conserve le dossier complet
# (paies, dossier médical, accidents du travail), qui n'a pas à être gardé
# indéfiniment.
# DELETED_EMPLOYEE_RETENTION_DAYS="30"

# ---------- Email ----------

# Sans configuration SMTP, les emails partent vers une boîte de test jetable :
# aucun salarié ne les reçoit. À renseigner avant d'annoncer les notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SIRH SII"

# Coupe tous les envois d'email en conservant les notifications en base.
# Utile sur un environnement de démonstration alimenté par des données réelles.
DISABLE_NOTIFICATION_EMAILS=

# ---------- Traitements planifiés ----------

# Acquisition mensuelle des congés, alertes d'échéances, relances, anomalies de
# pointage, célébrations, synthèse hebdomadaire. Actifs par défaut ; poser
# "true" pour les couper sur un environnement secondaire, sans quoi deux
# instances branchées sur la même base enverraient les mêmes relances en double.
DISABLE_SCHEDULED_JOBS=
