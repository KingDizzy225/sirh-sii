# ========================================
# SIRH-SII Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ========================================

# ---------- Indispensable ----------

PORT=3000
NODE_ENV=production

# Base de données PostgreSQL. Sur Render, utiliser l'URL *interne* pour le
# service web, l'URL *externe* pour se connecter depuis un poste.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Signature des jetons de session. 32 caractères minimum : en production, le
# serveur refuse de démarrer en deçà. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"

# Adresse du frontend. Sert à deux choses : restreindre les origines acceptées
# par l'API (sans elle, CORS accepte tout le monde) et construire les liens des
# emails et des QR codes de pointage.
FRONTEND_URL="https://sirh-sii.vercel.app"

# ---------- Comptes ----------

# Les comptes de démonstration (@sirh.com, mot de passe annoncé sur l'écran de
# connexion) sont recréés à chaque démarrage. Poser "true" AVANT d'ouvrir
# l'application à de vrais salariés, et créer d'abord un compte nominatif —
# sans quoi plus personne ne peut se connecter.
DISABLE_TEST_ACCOUNTS=

# Création du premier administrateur au démarrage, sans accès à la base.
# Le compte n'est jamais écrasé s'il existe déjà. Retirer le mot de passe des
# variables une fois le compte créé.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ---------- Intelligence artificielle ----------

# Claude (Anthropic) — alimente le chatbot, l'extraction de documents,
# les fiches de poste, le sourcing et les analyses.
ANTHROPIC_API_KEY=""

# Requis si votre clé n'est pas rattachée à un espace de travail : l'API la
# refuse alors avec « This API key is not scoped to a workspace ». L'identifiant
# se lit dans la console Anthropic, dans l'URL de l'espace de travail.
ANTHROPIC_WORKSPACE_ID=

# Facultatif : modèle et niveau d'effort.
# ANTHROPIC_MODEL="claude-opus-5"
# ANTHROPIC_EFFORT="medium"   # low | medium | high | xhigh | max

# ---------- Guichet WhatsApp ----------

# Permet aux salariés d'interroger le SIRH depuis WhatsApp (!solde, !paie,
# !conge). Sans ces variables, la logique reste accessible en simulation depuis
# l'écran RH, mais aucun salarié ne peut l'atteindre.
#
# Les quatre valeurs viennent de l'application Meta (developers.facebook.com) :
#   TOKEN            jeton d'accès permanent
#   PHONE_NUMBER_ID  identifiant du numéro expéditeur
#   VERIFY_TOKEN     chaîne de votre choix, redonnée à Meta à l'abonnement
#   APP_SECRET       secret de l'application ; sert à vérifier que les messages
#                    viennent bien de Meta. Sans lui, l'adresse du webhook étant
#                    publique, n'importe qui pourrait poser un congé au nom d'un
#                    salarié dont il connaît le numéro : la réception est donc
#                    refusée tant qu'il est absent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION="v21.0"

# Adresse publique de l'API, à coller comme webhook dans la console Meta.
# Renseignée automatiquement sur Render (RENDER_EXTERNAL_URL) ; à déclarer
# ailleurs. Ce n'est pas FRONTEND_URL : un webhook pointé sur le site
# n'atteindrait aucune route de l'API.
PUBLIC_API_URL=

# ---------- Congés ----------

# Barèmes du calcul des droits. Valeurs par défaut : Code du travail ivoirien et
# convention collective interprofessionnelle. À vérifier contre la convention
# applicable à votre branche, qui peut être plus favorable.
# LEAVE_ACCRUAL_DAYS_PER_MONTH="2.2"   # acquisition mensuelle (art. 25.1)
# LEAVE_MAX_BALANCE="60"               # plafond de cumul
# LEAVE_SENIORITY_SCALE="5:1,10:2,15:3,20:4,25:5,30:6"  # années:jours
# LEAVE_DAYS_PER_CHILD="2"             # par enfant à charge de moins de 14 ans
# LEAVE_CHILD_BONUS_GENDER="F"         # F | M | TOUS
# LEAVE_REFERENCE_YEAR_START="ANNIVERSAIRE"  # ou une date fixe, ex. "01-01"

# ---------- Budget ----------

# Nombre minimal de mois de paie renseignés avant qu'une projection annuelle
# soit calculée. En deçà, extrapoler l'année donnerait un chiffre plus trompeur
# qu'utile : un seul mois multiplié par douze n'est pas une prévision.
# BUDGET_MOIS_MIN_PROJECTION="3"

# ---------- Authentification Google Workspace ----------

# Identifiant client OAuth, créé dans la console Google Cloud (type
# « Application Web »). Sans lui, le bouton « Se connecter avec Google »
# n'apparaît pas.
GOOGLE_CLIENT_ID=

# Domaine de votre organisation Workspace. À renseigner impérativement : sans
# lui, n'importe quel compte Google — un compte Gmail personnel créé en trente
# secondes — pourrait ouvrir une session dans le SIRH.
GOOGLE_WORKSPACE_DOMAIN=

# Par défaut, un salarié inscrit au fichier du personnel obtient son compte à
# la première connexion. Poser "false" pour exiger que la RH crée les comptes
# à l'avance.
# GOOGLE_SSO_AUTO_PROVISION="true"

# ---------- Hébergement dans l'entreprise ----------

# L'application sert elle-même l'interface : un seul processus, un seul port,
# et plus aucune question d'origines croisées. Construire d'abord le frontend
# (npm run build à la racine). Voir docs/INSTALLATION-WINDOWS.md.
SERVE_FRONTEND=
# FRONTEND_DIST_DIR="C:\\SIRH\\dist"

# Destination des sauvegardes. Le contrôle de préparation vérifie qu'une
# sauvegarde récente s'y trouve : sur un serveur interne, personne n'en fait à
# votre place.
SAUVEGARDE_DESTINATION=

# ---------- Temps de travail ----------

# Durée hebdomadaire de référence, au-delà de laquelle les heures sont
# supplémentaires. Le décompte se fait semaine par semaine et non sur le mois :
# une semaine de cinquante heures suivie d'une semaine de trente n'est pas un
# mois ordinaire, et lisser les deux effacerait les heures dues.
# TEMPS_HEURES_HEBDOMADAIRES="40"

# Au-delà de cette durée, une journée est tenue pour aberrante — sortie
# vraisemblablement oubliée. Elle est écartée du décompte et signalée, plutôt
# que comptée ou passée sous silence.
# TEMPS_JOURNEE_MAX_HEURES="16"

# ---------- Signature électronique ----------

# Clé de scellement des documents émis (Ed25519, PEM PKCS#8, ou le même en
# base64 — les variables d'environnement supportant mal les retours à la ligne).
#
# À défaut, une clé est produite au premier usage et conservée en base : moins
# protégée qu'ici, mais stable. Une clé éphémère serait le pire choix — les
# sceaux d'hier deviendraient invérifiables aujourd'hui sans que rien ne le
# signale. Générer une clé :
#   node -e "const {privateKey}=require('crypto').generateKeyPairSync('ed25519'); console.log(Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
SIGNATURE_SEAL_PRIVATE_KEY=
# SIGNATURE_SEAL_KEY_ID="production-2026"

# Taille maximale d'une image de signature ou de cachet, en octets.
# SIGNATURE_IMAGE_MAX_OCTETS="409600"


# Durée de validité du lien de signature adressé au salarié, en heures. Un lien
# qui ne périme pas circule et finit par être réutilisé.
# SIGNATURE_LIEN_VALIDITE_HEURES="72"

# ---------- Rupture du contrat ----------

# Barème de l'indemnité de licenciement : "borneAnnées:taux,...". Le taux
# s'applique aux années comprises dans la tranche, non à la totalité de
# l'ancienneté. Défaut : 30 % jusqu'à 5 ans, 35 % de 6 à 10, 40 % au-delà —
# usage courant en Côte d'Ivoire, à vérifier contre votre convention.
# RUPTURE_BAREME_INDEMNITE="5:0.30,10:0.35,999:0.40"
# RUPTURE_ANCIENNETE_MINIMALE="1"

# Ville figurant en en-tête des courriers de procédure.
# ORGANISATION_VILLE="Abidjan"

# ---------- Sous-traitance ----------

# Durées de validité usuelles des attestations, en mois, et préavis d'alerte en
# jours. Servent à déduire une échéance quand la pièce n'en porte pas, et à
# relancer avant expiration. Une attestation périmée vaut une attestation
# absente : le donneur d'ordre répond des salariés non déclarés par son
# prestataire.
# SOUS_TRAITANCE_PREAVIS_JOURS="30"
# SOUS_TRAITANCE_VALIDITE_CNPS_MOIS="3"
# SOUS_TRAITANCE_VALIDITE_FISCAL_MOIS="3"
# SOUS_TRAITANCE_VALIDITE_RCCM_MOIS="12"
# SOUS_TRAITANCE_VALIDITE_ASSURANCE_MOIS="12"
# SOUS_TRAITANCE_VALIDITE_PERSONNEL_MOIS="6"

# ---------- Procédures disciplinaires ----------

# Délais de la procédure interne, en jours. Ce sont des valeurs par défaut, non
# des certitudes : le Code du travail ivoirien et les conventions collectives ne
# fixent pas tous les mêmes durées, et une convention de branche peut être plus
# protectrice. L'application n'impose que ce que l'entreprise s'est donné.
# PROCEDURE_DELAI_ENTRETIEN_JOURS="2"     # entre la convocation et l'entretien
# PROCEDURE_DELAI_EXPLICATION_JOURS="2"   # laissé au salarié pour s'expliquer
# PROCEDURE_DELAI_NOTIFICATION_JOURS="15" # au-delà, l'étape est signalée en retard

# ---------- Corbeille ----------

# Durée pendant laquelle un dossier salarié supprimé reste restaurable. Au-delà,
# il est purgé définitivement : la corbeille conserve le dossier complet
# (paies, dossier médical, accidents du travail), qui n'a pas à être gardé
# indéfiniment.
# DELETED_EMPLOYEE_RETENTION_DAYS="30"

# ---------- Email ----------

# Sans configuration SMTP, les emails partent vers une boîte de test jetable :
# aucun salarié ne les reçoit. À renseigner avant d'annoncer les notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SIRH SII"

# Coupe tous les envois d'email en conservant les notifications en base.
# Utile sur un environnement de démonstration alimenté par des données réelles.
DISABLE_NOTIFICATION_EMAILS=

# ---------- Traitements planifiés ----------

# Acquisition mensuelle des congés, alertes d'échéances, relances, anomalies de
# pointage, célébrations, synthèse hebdomadaire. Actifs par défaut ; poser
# "true" pour les couper sur un environnement secondaire, sans quoi deux
# instances branchées sur la même base enverraient les mêmes relances en double.
DISABLE_SCHEDULED_JOBS=

# ---------- Adresses publiques ----------

# Adresse de l'application telle qu'elle apparaît dans les liens remis aux
# salariés : bulletins, badges, bilans annuels, pré-accueil, livres d'or, QR de
# pointage. À défaut, FRONTEND_URL puis RENDER_EXTERNAL_URL sont utilisées.
PUBLIC_APP_URL=

# Adresse de l'API, à coller dans la console Meta pour le webhook WhatsApp.
PUBLIC_API_URL=

# Servir l'interface déjà construite depuis ce serveur plutôt que par un
# hébergement séparé. Construire d'abord l'interface (npm run build).
SERVE_FRONTEND=
# FRONTEND_DIST_DIR="../dist"

# ---------- Accès ----------

# Rôles admis à ouvrir une session. Les salariés n'ont pas de compte : ils
# passent par le portail public et par leur badge numérique.
ROLES_AUTORISES_CONNEXION="ADMIN,HR,MANAGER"

# ---------- Identité de l'entreprise ----------

# Valeur de repli seulement : le nom, le logo et les couleurs se saisissent
# dans l'application (Paramètres → Profil de l'entreprise) et priment sur ceci.
ORGANISATION_NAME="SII Côte d'Ivoire"
# ORGANISATION_VILLE="Abidjan"

# ---------- Notes vocales (WhatsApp) ----------

# Claude ne lit pas l'audio : la transcription passe par un service tiers qui
# expose « POST /audio/transcriptions » (multipart, réponse { text }). Sans ces
# variables, le salarié qui envoie un vocal est invité à écrire — il n'est
# jamais laissé sans réponse. La voix quitte alors l'entreprise vers ce
# service : à mentionner dans la déclaration ARTCI.
TRANSCRIPTION_URL=
TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL="whisper-1"
# TRANSCRIPTION_LANGUE="fr"
# VOCAL_TAILLE_MAX_OCTETS="5242880"

# ---------- Écrans d'agence, badges, bilans ----------

# Jour de paie (1 à 31). Sert au compte à rebours affiché sur les écrans
# d'agence ; sans lui, aucun compte à rebours n'est montré.
# JOUR_PAIE="25"

# Validité d'un badge numérique, en mois.
# BADGE_VALIDITE_MOIS="12"

# Fenêtres des annonces et des remerciements affichés sur les écrans, en jours.
# ECRAN_JOURS_ANNONCES="30"
# ECRAN_JOURS_KUDOS="14"

# Deux scans d'un même salarié à moins de N minutes ne comptent qu'une fois.
# POINTAGE_ECRAN_DOUBLON_MIN="2"

# Créneaux montrés au salarié sous son badge, en jours.
# ESPACE_JOURS_CRENEAUX="14"

# Livres d'or : plafonds contre les envois répétés.
# LIVRE_DOR_MOTS_MAX="500"
# LIVRE_DOR_ENVOIS_PAR_ADRESSE="5"

# ---------- Passations d'équipe ----------

# Passations montrées à la relève (heures) et report des points restés ouverts
# (jours), au-delà desquels ils relèvent du suivi RH plutôt que de la relève.
# PASSATION_HEURES="36"
# PASSATION_JOURS_REPORT="7"

# ---------- Émargement des formations ----------

# Délai minimal entre l'arrivée et le scan qui vaut départ, en minutes.
# EMARGEMENT_MINUTES_AVANT_DEPART="10"

# ---------- Prévision des absences ----------

# Seuils d'alerte (part de l'effectif habituel disponible) et historique de
# pointage exigé avant toute estimation. En deçà, seuls les congés validés et
# les fériés sont comptés, et l'écran le dit.
# PREVISION_SEUIL_TENDU="0.7"
# PREVISION_SEUIL_CRITIQUE="0.5"
# PREVISION_SEMAINES_MIN="8"

# ---------- Réglages métier ----------

# Taux de cotisation, majorations d'heures supplémentaires, barèmes de congés,
# seuils des contrôles de paie et de pointage : une centaine de variables, avec
# leurs valeurs par défaut et leur fondement réglementaire, sont documentées
# dans docs/RUNBOOK-PRODUCTION.md. N'en poser aucune sans cette lecture.

# ---------- Convention collective et minima ----------

# Salaire minimum légal mensuel. Sans lui, seuls les salariés dotés d'une
# catégorie conventionnelle sont contrôlés. La grille elle-même se saisit dans
# l'application (Pilotage RH → Grille conventionnelle).
# SMIG_MENSUEL="75000"

# ---------- Transport et avantages en nature ----------

# Part de la prime de transport exonérée de cotisations et d'impôt. À confirmer
# par le cabinet : un plafond dépassé se rattrape au contrôle.
# TRANSPORT_PLAFOND_EXONERE="30000"

# ---------- Délégués du personnel ----------

# Effectif à partir duquel l'élection s'impose, durée du mandat et préavis de
# renouvellement.
# DELEGUES_SEUIL_EFFECTIF="11"
# DELEGUES_DUREE_MANDAT_MOIS="24"
# DELEGUES_PREAVIS_JOURS="90"

# Nombre de délégués par tranche d'effectif, fixé par arrêté. Non renseigné,
# l'application suit les mandats sans annoncer un nombre qu'elle ignore.
# DELEGUES_BAREME='[{"jusqua":25,"titulaires":1,"suppleants":1},{"jusqua":50,"titulaires":2,"suppleants":2},{"jusqua":null,"titulaires":3,"suppleants":3}]'

# ---------- Sonde de bout en bout ----------

# Âge maximal admis pour la dernière sauvegarde, et boîte de contrôle où la
# sonde envoie son message d'essai.
# SONDE_SAUVEGARDE_AGE_MAX_H="30"
# SONDE_EMAIL_DESTINATAIRE=""

# ---------- Prime de fin d'année (treizième mois) ----------

# Fraction d'un salaire mensuel versée pour une année pleine : "1" pour un
# treizième mois entier, "0.5" pour un demi. Non renseignée, l'application ne
# calcule rien — le treizième mois n'est pas une obligation légale générale,
# il tient à la convention collective ou à un usage de l'entreprise.
# PRIME_FIN_ANNEE_FRACTION=""

# Mois de paie sur lequel la prime est portée, et ancienneté minimale exigée
# dans l'exercice, en mois de présence.
# PRIME_FIN_ANNEE_MOIS="12"
# PRIME_FIN_ANNEE_MOIS_MINIMUM="0"

# ---------- Provision pour congés payés ----------

# Nombre de bulletins retenus pour le brut moyen qui valorise une journée.
# PROVISION_CONGES_MOIS_MOYENNE="12"

# ---------- Astreintes ----------

# Forfaits par type d'astreinte, en FCFA. Non renseignés, la compensation est
# saisie période par période : aucun montant n'est inventé.
# ASTREINTE_FORFAITS='{"SEMAINE":15000,"WEEKEND":25000,"FERIE":30000,"NUIT":10000}'

# Repos attendu entre deux astreintes d'un même salarié, en jours. En deçà,
# le planning le signale.
# ASTREINTE_REPOS_JOURS="7"

# ---------- Bilan social ----------

# Jours ouvrés d'une année, dénominateur du taux d'absentéisme.
# BILAN_JOURS_OUVRES_AN="260"

# ---------- Attestations ----------

# Nombre de mois de paie repris par une attestation de salaire. L'attestation
# dit combien de mois elle a réellement trouvés : elle n'extrapole jamais.
# ATTESTATION_SALAIRE_MOIS="3"

# ---------- Départs à la retraite ----------

# Âge de départ retenu, et préavis d'anticipation de la prévision.
# RETRAITE_AGE="60"
# RETRAITE_PREAVIS_MOIS="12"

# Barème de l'allocation de fin de carrière : "borneAnnées:taux,...".
# Non déclaré, l'allocation n'est pas chiffrée — et le reçu pour solde de tout
# compte d'un départ à la retraite est bloqué plutôt qu'amputé.
# RETRAITE_BAREME_ALLOCATION="5:0.20,10:0.25,999:0.30"

# ---------- Ordres de mission ----------

# Forfaits de per diem par zone, en FCFA et par jour. Non déclarés, le montant
# est saisi mission par mission.
# MISSION_PER_DIEM='{"LOCALE":10000,"INTERIEUR":20000,"ETRANGER":50000}'

# ---------- Indemnités journalières CNPS ----------

# Taux d'indemnisation servant à estimer une créance (entre 0 et 1). Non
# déclaré, aucune estimation n'est produite : le régime CNPS n'est pas codé
# dans l'application.
# CNPS_TAUX_IJ=""

# Délai au-delà duquel une demande n'est plus recevable, en jours.
# CNPS_IJ_DELAI_JOURS="730"

# ---------- Travailleurs handicapés ----------

# Quota d'emploi applicable, en pourcentage de l'effectif. Sans quota déclaré,
# le bilan social rend le taux constaté sans prononcer de conformité.
# QUOTA_TRAVAILLEURS_HANDICAPES=""
