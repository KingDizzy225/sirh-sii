generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 1. EMPLOYEES & CORE SYSTEM
// ----------------------------------------------------

model Employee {
  id            String   @id @default(uuid())
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  email         String   @unique
  role          String // 'Employee', 'Manager', 'HR', 'Administrator', 'Social Worker'
  department    String
  status        String // 'ACTIVE', 'ON_LEAVE', 'TERMINATED'
  hireDate      DateTime @map("hire_date")
  positionTitle String   @map("position_title")
  managerId     String?  @map("manager_id") // ID du manager direct

  // Nouveaux champs RH
  birthDate   DateTime? @map("birth_date")
  gender      String?   @default("Non spécifié")
  phone       String?
  address     String?
  nationality String?

  // Dossier administratif. Ces mentions sont exigées par la déclaration CNPS et
  // par le registre unique du personnel : sans elles, le registre s'imprime
  // mais n'est pas recevable, et la déclaration est rejetée après dépôt.
  matricule     String?  @unique // matricule interne, unique dans l'entreprise
  cnpsNumber    String?  @map("cnps_number")
  bankName      String?  @map("bank_name")
  bankAccount   String?  @map("bank_account")
  // Nombre d'enfants à charge de moins de 14 ans : entre dans le calcul du
  // congé supplémentaire (voir lib/conges.js), pas dans la paie.
  childrenCount Int      @default(0) @map("children_count")

  /// Rémunération de référence, en FCFA.
  ///
  /// L'application ignorait ce que gagnait un salarié : `runPayroll` lisait le
  /// salaire dans le corps de la requête, et l'analyse d'équité le déduisait du
  /// dernier bulletin. Le salaire était donc une conséquence — ce qui a été
  /// payé — et non une donnée du contrat. Il fallait le ressaisir à chaque
  /// paie, rien ne signalait un écart d'un mois sur l'autre, et une
  /// augmentation ne se décidait nulle part.
  baseSalary          Float?    @map("base_salary")
  salaryEffectiveFrom DateTime? @map("salary_effective_from")

  salaryChanges SalaryChange[]
  delegationsDonnees DelegationValidation[] @relation("Titulaire")
  delegationsRecues  DelegationValidation[] @relation("Suppleant")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  // Le solde n'est plus forfaitaire : 30 jours par défaut créditaient une année
  // entière de congés à tout salarié dès sa création, y compris à un import en
  // masse. Il est désormais calculé à la création (lib/conges.js) ou repris du
  // système précédent, et `leaveBalanceSource` dit lequel des deux.
  annualLeaveBalance Float     @default(0) @map("annual_leave_balance")
  leaveBalanceSource String?   @map("leave_balance_source") // 'CALCUL' | 'REPRISE'
  leaveBalanceSetAt  DateTime? @map("leave_balance_set_at")
  exitDate           DateTime? @map("exit_date")
  offboardingStatus  String?   @default("N/A") @map("offboarding_status")
  contractType       String?   @default("CDI") @map("contract_type")
  contractEndDate    DateTime? @map("contract_end_date")
  trialPeriodEndDate DateTime? @map("trial_period_end_date")

  // Relations
  manager              Employee?               @relation("Hierarchy", fields: [managerId], references: [id], onDelete: Cascade)
  subordinates         Employee[]              @relation("Hierarchy")
  payrolls             Payroll[]
  leaves               Leave[]
  skills               EmployeeSkill[]
  supportTickets       SupportTicket[]         @relation("SupportTickets")
  assets               AssetAssignment[]
  participations       TrainingParticipation[]
  performanceGoals     PerformanceGoal[]       @relation("GoalOwner")
  performanceReviews   PerformanceReview[]     @relation("ReviewSubject")
  performanceFeedbacks PerformanceFeedback[]   @relation("FeedbackSubject")
  documents            EmployeeDocument[]      @relation("EmployeeDocs")
  notifications        Notification[]          @relation("EmployeeNotifications")
  expenses             Expense[]
  advances             SalaryAdvance[]
  medicalVisits        MedicalVisit[]
  points               EmployeePoints?
  pointEvents          PointEvent[]
  talentProfile        TalentProfile?          @relation("EmployeeTalent")
  offboardingTasks     OffboardingTask[]
  onboardingTasks      OnboardingTask[]
  shifts               ShiftSchedule[]
  benefits             EmployeeBenefit[]
  timeLogs             TimeLog[]
  absences             Absence[]               @relation("EmployeeAbsences")
  careerHistory        CareerHistory[]
  disciplinaryRecords  DisciplinaryRecord[]
  kudosSent            Kudo[]                  @relation("SentKudos")
  kudosReceived        Kudo[]                  @relation("ReceivedKudos")
  orgNodes             OrgSimulationNode[]     @relation("EmployeeOrgNodes")
  successors           Successor[]             @relation("EmployeeSuccessors")
  retentionActions     RetentionAction[]       @relation("EmployeeRetention")
  referrals            Referral[]              @relation("EmployeeReferrals")
  mentorRelations      MentorshipRelation[]    @relation("MentorEmployee")
  menteeRelations      MentorshipRelation[]    @relation("MenteeEmployee")
  medicalRecords       MedicalRecord[]
  workAccidents        WorkAccident[]
  issuedDocuments      IssuedDocument[]
  exitInterview        ExitInterview?
  procedures           Procedure[]
  jobDescriptions      JobDescription[]
  situations           SituationEmployee[]
  soldeToutCompte      SoldeToutCompte?
  pieces               PieceSalarie[]
}

// ... (existing code)

// ----------------------------------------------------
// 27. KUDOS (PEER RECOGNITION)
// ----------------------------------------------------

model Kudo {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  message    String
  category   String // 'Teamwork', 'Innovation', 'Leadership', 'Efficiency'
  createdAt  DateTime @default(now()) @map("created_at")

  sender   Employee @relation("SentKudos", fields: [senderId], references: [id], onDelete: Cascade)
  receiver Employee @relation("ReceivedKudos", fields: [receiverId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 2. PAIE (PAYROLL)
// ----------------------------------------------------

model Payroll {
  id                    String    @id @default(uuid())
  employeeId            String    @map("employee_id")
  period                DateTime // Représente le mois de paie (ex: 2026-01-01)
  baseSalary            Float     @map("base_salary")
  bonus                 Float     @default(0)
  deductions            Float     @default(0)
  overtimeHours         Float     @default(0) @map("overtime_hours")
  leaveDays             Float     @default(0) @map("leave_days")
  employerContributions Float     @default(0) @map("employer_contributions")
  employeeContributions Float     @default(0) @map("employee_contributions")
  netSalary             Float     @default(0) @map("net_salary")

  // Décomposition du bulletin. Ces montants étaient recalculés à la volée par
  // chaque consommateur, avec des formules divergentes ; les enregistrer fige
  // le bulletin tel qu'il a été remis au salarié et rend les déclarations
  // sociales vérifiables. Nuls sur les fiches antérieures à leur ajout.
  grossSalary    Float? @map("gross_salary")
  overtimeAmount Float? @map("overtime_amount")
  leaveDeduction Float? @map("leave_deduction")
  cnpsEmployee   Float? @map("cnps_employee")
  cmu            Float?
  taxableIncome  Float? @map("taxable_income")
  its            Float?
  pdfPath               String?   @map("pdf_path")
  signature             String? // Base64 signature
  signedAt              DateTime? @map("signed_at")
  status                String    @default("DRAFT") // 'DRAFT', 'APPROVED', 'PAID'
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 3. CONGÉS & ABSENCES (LEAVES)
// ----------------------------------------------------

model Leave {
  id             String   @id @default(uuid())
  employeeId     String   @map("employee_id")
  type           String // 'Annual', 'Sick', 'Maternity', 'Unpaid'
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  status         String // 'Pending', 'Approved', 'Rejected'
  durationDays   Float    @map("duration_days")
  reason         String?
  attachmentPath String?  @map("attachment_path")
  createdAt      DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 4. ASSISTANT SOCIAL (SUPPORT TICKETS)
// ----------------------------------------------------

model SupportTicket {
  id          String   @id @default(uuid())
  requesterId String?  @map("requester_id") // Nullable if anonymous
  category    String // 'Logement', 'Famille', 'Finances', etc.
  priority    String // 'Low', 'Medium', 'High', 'Urgent'
  status      String // 'Ouvert', 'En cours', 'Résolu', 'Fermé'
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  title       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requester Employee?        @relation("SupportTickets", fields: [requesterId], references: [id], onDelete: Cascade)
  messages  SupportMessage[] @relation("TicketMessages")
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  sender    String // 'Employé' ou 'Assistante'
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation("TicketMessages", fields: [ticketId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 5. GPEC (COMPÉTENCES)
// ----------------------------------------------------

model EmployeeSkill {
  id                   String   @id @default(uuid())
  employeeId           String   @map("employee_id")
  skillName            String   @map("skill_name")
  proficiencyLevel     String   @map("proficiency_level") // 'Débutant', 'Intermédiaire', 'Avancé', 'Expert'
  interestedInTraining Boolean  @default(false) @map("interested_in_training")
  createdAt            DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 6. MATÉRIEL (ASSET MANAGEMENT)
// ----------------------------------------------------

model Asset {
  id              String    @id @default(uuid())
  assetTag        String    @unique @map("asset_tag")
  category        String
  model           String
  status          String // 'Available', 'Assigned', 'In Repair', 'Retired'
  departmentOwner String    @map("department_owner")
  purchaseDate    DateTime? @map("purchase_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  assignments AssetAssignment[]
}

model AssetAssignment {
  id              String    @id @default(uuid())
  assetId         String    @map("asset_id")
  employeeId      String    @map("employee_id")
  assignedDate    DateTime  @default(now()) @map("assigned_date")
  returnedDate    DateTime? @map("returned_date")
  returnCondition String?   @map("return_condition")

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 7. COMPLIANCE (AUDIT TRAIL)
// ----------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") // ID de l'utilisateur qui a fait l'action
  action    String // PUT, PATCH, DELETE
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  oldData   String?  @map("old_data") // JSON en string
  newData   String?  @map("new_data") // JSON en string
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
}

// ----------------------------------------------------
// 8. RECRUTEMENT (JOB OFFERS & APPLICANTS)
// ----------------------------------------------------

model JobOffer {
  id             String   @id @default(uuid())
  title          String
  department     String
  location       String // ex: 'Abidjan', 'Remote', 'Dakar'
  type           String // 'CDI', 'CDD', 'Stage', 'Freelance'
  status         String // 'Active', 'Closed', 'Draft'
  experienceMode String   @default("Junior") @map("experience_mode")
  description    String?
  // Profil recherché. Le formulaire de création le collectait et le contrôleur
  // l'écrivait, mais la colonne n'existait pas : Prisma rejetait l'appel et
  // aucune offre ne pouvait être publiée depuis l'application.
  requirements   String?
  createdAt      DateTime @default(now()) @map("created_at")

  applicants Applicant[]
  referrals  Referral[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("HR") // ADMIN, HR, MANAGER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Applicant {
  id          String   @id @default(uuid())
  jobOfferId  String   @map("job_offer_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String
  phone       String?
  status      String // 'Applied', 'Screening', 'Interview', 'Offered', 'Hired', 'Rejected'
  matchScore  Int      @default(0) @map("match_score") // Score de correspondance (ex: 85)
  source      String   @default("LinkedIn")
  // Chemin du CV téléversé. Le contrôleur l'écrivait déjà alors que le champ
  // n'existait pas : toute candidature depuis le site carrière échouait.
  resumeUrl   String?  @map("resume_url")
  // Expérience déclarée par le candidat, transmise par le formulaire de
  // candidature et écrite par le contrôleur alors que la colonne manquait.
  experience  String?
  appliedDate DateTime @default(now()) @map("applied_date")
  /// Date de passage au statut « recrutée ».
  ///
  /// Le délai de recrutement s'affichait au tableau de bord sous la forme de
  /// six valeurs écrites en dur : la candidature portait sa date de dépôt et
  /// son statut, jamais la date à laquelle elle avait abouti, si bien que le
  /// délai n'était pas calculable. Il l'est à partir d'ici — et l'indicateur
  /// reste vide tant qu'aucun recrutement n'a été conclu dans l'application,
  /// ce qui est la réponse exacte.
  hiredAt     DateTime? @map("hired_at")

  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 9. FORMATION (TRAINING MODULES & CAHIER)
// ----------------------------------------------------

model TrainingSession {
  id            String   @id @default(uuid())
  title         String // Nom du module de formation
  description   String?
  trainerName   String   @map("trainer_name") // Nom du formateur
  date          DateTime // Date de réalisation
  durationHours Float    @map("duration_hours") // Durée en heures
  status        String   @default("Completed") // Par défaut les formations ajoutées sont considérées comme effectuées
  targetSkill   String?  @map("target_skill")
  targetLevel   String?  @default("Intermédiaire") @map("target_level")
  createdAt     DateTime @default(now()) @map("created_at")

  participations TrainingParticipation[]
  modules        CourseModule[]
}

model TrainingParticipation {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  employeeId       String   @map("employee_id")
  completionStatus String   @default("Completed") @map("completion_status")
  createdAt        DateTime @default(now()) @map("created_at")

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  moduleProgresses ModuleProgress[]

  @@unique([sessionId, employeeId]) // Un employé ne peut pas participer deux fois à la même session unique
}

model CourseModule {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  title         String
  content       String? // Texte riche de la leçon
  mediaUrl      String?  @map("media_url") // Lien externe vers PDF, YouTube, etc.
  orderSequence Int      @default(0) @map("order_sequence")
  createdAt     DateTime @default(now()) @map("created_at")

  session    TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  progresses ModuleProgress[]
}

model ModuleProgress {
  id              String   @id @default(uuid())
  participationId String   @map("participation_id")
  moduleId        String   @map("module_id")
  completedDate   DateTime @default(now()) @map("completed_date")

  participation TrainingParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  module        CourseModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([participationId, moduleId])
}

// ----------------------------------------------------
// 10. PERFORMANCE & REVIEW
// ----------------------------------------------------

model PerformanceGoal {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  title      String
  category   String // 'Dév. Professionnel', 'Objectif Commercial', 'Leadership'
  progress   Int      @default(0)
  status     String   @default("En bonne voie") // 'En bonne voie', 'À risque', 'Terminé'
  dueDate    DateTime @map("due_date")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation("GoalOwner", fields: [employeeId], references: [id], onDelete: Cascade)
}

model PerformanceReview {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  reviewerName String   @map("reviewer_name")
  cycle        String // ex: 'Annuel 2026', 'Mi-année 2026'
  rating       String   @default("En attente") // 'Dépasse les attentes', 'Répond aux attentes', etc.
  status       String   @default("Brouillon") // 'Brouillon Soumis', 'Finalisé'
  reviewDate   DateTime @default(now()) @map("review_date")
  achievements String?
  reflection   String?
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
}

model PerformanceFeedback {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  provider     String
  relationship String   @default("Collègue")
  strengths    String?  @default("En attente de retour...")
  areas        String?  @default("En attente de retour...")
  context      String?
  badge        String? // Pour la gamification 360
  isAnonymous  Boolean  @default(false) @map("is_anonymous")
  peerId       String?  @map("peer_id")
  date         DateTime @default(now())
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee @relation("FeedbackSubject", fields: [employeeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 11. GESTION ÉLECTRONIQUE DE DOCUMENTS (GED)
// ----------------------------------------------------

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  title      String // Ex: 'Contrat de Travail', 'Fiche de paie Mai'
  type       String // Ex: 'Paie', 'Contrat', 'Identité', 'Autre'
  filePath   String   @map("file_path") // Le chemin du fichier (ex: /uploads/...)
  fileSize   Int      @default(0) @map("file_size") // en octets
  uploadedBy String   @map("uploaded_by") // Nom ou ID de la personne ayant uploadé
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // --- Signature ---
  //
  // La page publique de signature s'ouvrait sur l'identifiant du document, et
  // la route de signature ne vérifiait rien : quiconque disposait de cet
  // identifiant pouvait signer au nom du salarié. Le certificat produit
  // annonçait pourtant « Lien Magique Unique (Jeton cryptographique) », un
  // mécanisme qui n'existait pas.
  //
  // Le jeton ci-dessous est ce mécanisme : aléatoire, à usage unique, daté.
  signatureToken   String?   @unique @map("signature_token")
  tokenExpiresAt   DateTime? @map("token_expires_at")
  signatureRequestedBy String? @map("signature_requested_by")

  signedAt   DateTime? @map("signed_at")
  signedBy   String?   @map("signed_by")
  signedIp   String?   @map("signed_ip")

  /// Empreinte SHA-256 du document au moment de la signature. Sans elle, rien
  /// ne relie la signature au contenu signé : une image apposée sur un PDF neuf
  /// ne prouve rien de ce qui a été accepté.
  signatureHash String? @map("signature_hash")

  /// Le certificat est un fichier distinct. La signature écrasait auparavant le
  /// document par une page de certificat seule : après signature, le contrat
  /// n'était plus attaché au dossier.
  certificatePath String? @map("certificate_path")
  employee Employee @relation("EmployeeDocs", fields: [employeeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 12. NOTIFICATIONS & ALERTES
// ----------------------------------------------------

// Registre des documents officiels émis, pour vérification publique par QR code.
//
// Les informations sont figées au moment de l'émission : vérifier un document,
// c'est confirmer ce qu'il affirmait à sa date, même si la situation du salarié
// a changé depuis. Seules les mentions déjà portées sur le document sont
// exposées publiquement — jamais de rémunération ni de coordonnées.
model IssuedDocument {
  id            String    @id @default(uuid())
  token         String    @unique // aléatoire et non devinable, encodé dans le QR
  type          String // 'ATTESTATION_TRAVAIL', 'BULLETIN_PAIE'
  employeeId    String    @map("employee_id")
  // Enregistrement d'origine (ex. identifiant de la fiche de paie). Permet de
  // retrouver le jeton existant plutôt que d'en créer un à chaque régénération
  // du PDF, ce qui invaliderait les QR déjà remis.
  sourceId      String?   @map("source_id")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  issuedByEmail String?   @map("issued_by_email")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  // Instantané des mentions portées sur le document
  employeeName  String  @map("employee_name")
  positionTitle String? @map("position_title")
  department    String?
  hireDate      DateTime? @map("hire_date")

  // --- Signature de l'employeur ---
  //
  // Ce que remplace la signature manuscrite : le nom et la qualité du
  // signataire, et un sceau cryptographique qui permet à un tiers de vérifier
  // que le document vient bien de cette entreprise et n'a pas été retouché.
  // Sans lui, un document non imprimé ne serait qu'un fichier parmi d'autres.
  signataireNom      String? @map("signataire_nom")
  signataireFonction String? @map("signataire_fonction")
  /// Le manifeste est conservé tel qu'il a été scellé, au caractère près : une
  /// reconstruction qui réordonnerait ses clés invaliderait un sceau légitime.
  manifeste          String? @db.Text
  sceau              String? @db.Text
  sceauKeyId         String? @map("sceau_key_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("issued_document")
}

/// Signataire habilité à engager l'entreprise sur les documents qu'elle émet.
///
/// Les documents produits par l'application sortaient sans signature : ils
/// étaient imprimés, signés à la main, puis rescannés — trois manipulations, un
/// délai, et un fichier de moins bonne qualité que l'original. La signature est
/// désormais enregistrée une fois et apposée à l'émission.
model Signataire {
  id       String @id @default(uuid())
  nom      String
  fonction String

  /// Image de la signature manuscrite, en data URL. Elle est saisie une fois,
  /// au trait ou par téléversement.
  signatureImage String  @map("signature_image") @db.Text
  /// Cachet de l'entreprise, facultatif : beaucoup de destinataires l'attendent
  /// à côté de la signature.
  cachetImage    String? @map("cachet_image") @db.Text

  actif     Boolean  @default(true)
  /// Signataire proposé par défaut à l'émission.
  parDefaut Boolean  @default(false) @map("par_defaut")

  creePar   String?  @map("cree_par")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([actif])
  @@map("signataires")
}

// Entretien de sortie.
//
// Seule occasion d'apprendre pourquoi les gens partent, et matière première du
// module anti-turnover, qui prédisait jusqu'ici le risque sans jamais
// confronter ses hypothèses aux motifs réels.
model ExitInterview {
  id             String   @id @default(uuid())
  employeeId     String   @unique @map("employee_id")
  conductedAt    DateTime @default(now()) @map("conducted_at")
  conductedBy    String?  @map("conducted_by")
  departureType  String   @map("departure_type") // 'Démission', 'Licenciement', 'Fin de CDD', 'Rupture période essai', 'Retraite', 'Autre'
  primaryReason  String   @map("primary_reason") // 'Rémunération', 'Évolution', 'Management', 'Charge de travail', 'Projet personnel', 'Mobilité géographique', 'Autre'
  wouldRecommend Boolean? @map("would_recommend")
  satisfaction   Int?     // 1 à 5
  whatWorked     String?  @map("what_worked")
  whatToImprove  String?  @map("what_to_improve")
  comments       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("exit_interview")
}

// Journal des tâches planifiées.
// Le service Render s'endort et redémarre fréquemment : les tâches ne peuvent
// pas se fier au seul déclenchement horaire. Chaque exécution est enregistrée
// pour une période donnée, ce qui rend les traitements rejouables sans risque
// de double application (un rattrapage a lieu à chaque réveil du serveur).
model ScheduledJobRun {
  id        String   @id @default(uuid())
  jobName   String   @map("job_name") // ex: 'LEAVE_ACCRUAL'
  period    String // ex: '2026-09' pour un traitement mensuel, '2026-09-04' pour un quotidien
  runAt     DateTime @default(now()) @map("run_at")
  details   String? // résumé lisible de ce qui a été traité

  @@unique([jobName, period])
  @@map("scheduled_job_run")
}

model Notification {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  message    String
  type       String   @default("Info") // 'Info', 'Alerte', 'Succès'
  isRead     Boolean  @default(false) @map("is_read")
  link       String? // Lien web de redirection si on clique sur la notif
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation("EmployeeNotifications", fields: [employeeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 13. NOTES DE FRAIS (EXPENSES)
// ----------------------------------------------------

model Expense {
  id              String   @id @default(uuid())
  employeeId      String   @map("employee_id")
  amount          Float
  currency        String   @default("FCFA")
  category        String // 'Équipement', 'Déplacement', 'Repas', 'Hébergement', 'Autre'
  merchant        String?
  date            DateTime
  status          String   @default("En attente") // 'En attente', 'Approuvé', 'Rejeté'
  rejectionReason String?  @map("rejection_reason")
  // Justificatif téléversé. Le contrôleur l'écrivait déjà alors que le champ
  // n'existait pas : Prisma rejetant les champs inconnus, toute création de
  // note de frais échouait.
  receiptPath     String?  @map("receipt_path")
  // Signalé au valideur quand le montant dépasse le plafond de sa catégorie
  exceedsPolicy   Boolean  @default(false) @map("exceeds_policy")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

