}

// ----------------------------------------------------
// 21. POINTAGE (TIME & ATTENDANCE)
// ----------------------------------------------------

model TimeLog {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  type       String // 'CLOCK_IN' or 'CLOCK_OUT'
  timestamp  DateTime @default(now())

  // Référence produite par l'appareil au moment du pointage.
  //
  // Hors connexion, le pointage attend dans une file locale et repart au retour
  // du réseau. Si la requête atteint le serveur mais que la réponse se perd —
  // le cas ordinaire d'une liaison de chantier — l'appareil la croit échouée et
  // la renvoie. Sans cette clé, la journée du salarié compterait deux entrées.
  clientRef  String?  @unique @map("client_ref")

  // Géolocalisation du pointage (facultatif : null si le GPS n'était pas disponible)
  latitude        Float?
  longitude       Float?
  accuracy        Float? // précision GPS en mètres
  distanceMeters  Int?     @map("distance_meters") // distance au site le plus proche
  withinPerimeter Boolean? @map("within_perimeter")
  workSiteId      String?  @map("work_site_id")

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSite WorkSite? @relation(fields: [workSiteId], references: [id], onDelete: SetNull)
}

// Site de travail autorisé pour le pointage géolocalisé
model WorkSite {
  id           String   @id @default(uuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(200) @map("radius_meters")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  timeLogs TimeLog[]
}

