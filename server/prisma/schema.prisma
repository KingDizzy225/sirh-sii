// ----------------------------------------------------
// 33. WHATSAPP & SMS GATEWAY (OPTION A)
// ----------------------------------------------------

model WhatsappLog {
  id          String   @id @default(uuid())
  phoneNumber String   @map("phone_number")
  command     String
  response    String   @db.Text
  status      String   @default("SUCCESS") // 'SUCCESS', 'ERROR'
  createdAt   DateTime @default(now()) @map("created_at")

  // Identifiant du message chez l'opérateur. WhatsApp réémet un message tant
  // qu'il n'a pas reçu d'accusé : sans cette clé unique, une demande de congé
  // serait enregistrée plusieurs fois.
  messageId   String?  @unique @map("message_id")
  // 'ENTRANT' (message du salarié) ou 'SIMULATION' (essai depuis l'écran RH) :
  // un essai ne doit pas se lire comme un message réellement reçu.
  direction   String   @default("ENTRANT")
  // Vrai si la réponse est effectivement partie chez l'opérateur. Une réponse
  // calculée mais non remise laisse le salarié sans nouvelle.
  delivered   Boolean  @default(false)

  @@index([createdAt])
}

// ----------------------------------------------------
// 34. HUB SANTÉ ET VISITES MÉDICALES (OPTION B)
// ----------------------------------------------------

/// Règles internes de l'entreprise, sur lesquelles l'assistant RH s'appuie.
///
/// L'assistant portait jusqu'ici ces règles en dur dans son prompt — « 8h-17h,
/// 30 jours de congés, mutuelle 80 % » — et répondait donc la même chose à
/// toutes les entreprises, quelles que soient leurs propres textes. Une réponse
/// plausible mais fausse sur un droit à congés est pire qu'une absence de
/// réponse : le salarié l'applique.
///
/// Chaque règle porte sa source pour que l'assistant puisse la citer, et que
/// quiconque lit une réponse puisse remonter au texte qui la fonde.
model PolicyRule {
  id        String   @id @default(uuid())
  title     String
  /// 'Congés', 'Horaires', 'Rémunération', 'Discipline', 'Santé', 'Autre'
  category  String   @default("Autre")
  content   String   @db.Text
  /// Référence du texte d'origine — « Règlement intérieur, art. 12 ».
  source    String?
  active    Boolean  @default(true)
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, category])
}

/// Modèle de parcours d'intégration ou de départ, éditable par la RH.
///
/// Ces parcours vivaient jusqu'ici dans `data/onboardingTemplates.js` : les
/// modifier supposait un développeur et un déploiement, alors que la liste des
/// formalités d'arrivée est précisément ce qu'une entreprise ajuste. Le
/// constructeur de workflows en proposait l'édition, mais tenait ses modèles
/// dans un tableau écrit en dur et ne les enregistrait nulle part.
///
/// Sans modèle actif en base, l'application retombe sur le fichier de code :
/// le comportement reste celui d'aujourd'hui tant que rien n'a été personnalisé.
model TaskTemplate {
  id          String   @id @default(uuid())
  name        String
  type        String // 'ONBOARDING' | 'OFFBOARDING'
  /// Famille de métier ciblée, reprise du référentiel de carrière.
  /// Vide : le modèle s'applique à toute arrivée ou tout départ.
  family      String?
  description String?
  active      Boolean  @default(true)
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items TaskTemplateItem[]

  @@index([type, active])
}

model TaskTemplateItem {
  id          String  @id @default(uuid())
  templateId  String  @map("template_id")
  title       String
  /// Équipe responsable : c'est elle qui structure le tableau des tâches.
  assignedTo  String
  /// Décalage en jours par rapport à la date d'arrivée ou de départ.
  /// Négatif pour ce qui doit être fait avant.
  relativeDays Int    @default(0) @map("relative_days")
  description String?
  position    Int     @default(0)

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// Registre des accidents du travail, de trajet et des presque-accidents.
///
/// La page HSE tenait ce registre dans un tableau écrit en dur : rien de ce qui
/// y était consigné ne survivait au rechargement. Or c'est un document que
/// l'inspection du travail peut demander, et un accident du travail se déclare
/// à la CNPS dans un délai contraint.
model WorkAccident {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  reference   String   @unique // AT-2026-001
  occurredAt  DateTime @map("occurred_at")
  location    String
  // 'Accident du travail', 'Accident de trajet', 'Presque-accident',
  // 'Maladie professionnelle'
  type        String
  severity    String // 'Mineur', 'Majeur', 'Grave'
  description String

  // Arrêt de travail prescrit, en jours. Détermine le taux de gravité et
  // conditionne la déclaration.
  daysOff     Int      @default(0) @map("days_off")

  declaredToCnps   Boolean   @default(false) @map("declared_to_cnps")
  declaredAt       DateTime? @map("declared_at")
  correctiveAction String?   @map("corrective_action")
  status           String    @default("Déclaré") // 'Déclaré', 'Enquête en cours', 'Clos'

  reportedBy String?  @map("reported_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
}

model MedicalRecord {
  id              String    @id @default(uuid())
  employeeId      String    @map("employee_id")
  visitType       String    @map("visit_type") // 'ANNUAL', 'RECRUITMENT', 'RECONVERSION'
  visitDate       DateTime  @map("visit_date")
  doctorName      String?   @map("doctor_name")
  aptitudeStatus  String    @map("aptitude_status") // 'FIT', 'FIT_WITH_RESTRICTION', 'UNFIT'
  nextCheckupDate DateTime? @map("next_checkup_date")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 35. BAROMÈTRE CLIMAT SOCIAL & ENPS (OPTION C)
// ----------------------------------------------------

model ClimateSurvey {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("ACTIVE") // 'ACTIVE', 'CLOSED'
  enpsScore   Float    @default(0) @map("enps_score")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  responses SurveyResponse[]
}

model SurveyResponse {
  id         String   @id @default(uuid())
  surveyId   String   @map("survey_id")
  score      Int      // 0 to 10
  feedback   String?  @db.Text
  department String?
  createdAt  DateTime @default(now()) @map("created_at")

  survey ClimateSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}




// ----------------------------------------------------
// CORBEILLE — RESTAURATION DES SUPPRESSIONS
// ----------------------------------------------------

/// Copie intégrale d'un dossier salarié prise juste avant sa suppression.
///
/// Supprimer un salarié efface en cascade une trentaine de tables — paies,
/// congés, dossier médical, accidents du travail. Ce n'est pas une panne de la
/// base : la sauvegarde quotidienne de l'hébergeur ne peut pas défaire ce seul
/// geste sans annuler tout le reste de la journée. L'instantané est donc pris
/// côté application, et permet de reconstituer le dossier.
model DeletedEmployee {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  email         String
  department    String
  positionTitle String    @map("position_title")

  /// Dossier complet : l'enregistrement Employee et toutes ses lignes liées,
  /// table par table. Sert de source unique à la restauration.
  snapshot      Json
  /// Nombre de lignes liées capturées, affiché avant restauration.
  relatedCount  Int       @default(0) @map("related_count")

  deletedAt     DateTime  @default(now()) @map("deleted_at")
  deletedBy     String?   @map("deleted_by")
  restoredAt    DateTime? @map("restored_at")
  restoredBy    String?   @map("restored_by")

  @@index([deletedAt])
  @@map("deleted_employees")
}

// ----------------------------------------------------
// PROCÉDURES DISCIPLINAIRES ET DE RUPTURE
// ----------------------------------------------------

/// Procédure ouverte à l'égard d'un salarié : sanction, licenciement,
/// rupture d'essai, démission.
///
/// Le dossier disciplinaire enregistrait la décision — une date, un type, un
/// motif — sans rien savoir du chemin qui y mène. Or c'est la forme qui se
/// conteste : convocation non remise, entretien tenu le jour même, lettre sans
/// motif. Cette procédure retient chaque étape, sa date, et sa preuve.
model Procedure {
  id         String    @id @default(uuid())
  employeeId String    @map("employee_id")
  type       String // LICENCIEMENT | SANCTION | RUPTURE_ESSAI | DEMISSION
  motif      String    @db.Text
  /// EN_COURS | CLOTUREE | ABANDONNEE
  statut     String    @default("EN_COURS")
  /// Issue consignée à la clôture : sanction retenue, rupture effective, abandon.
  issue      String?   @db.Text

  ouvertePar String    @map("ouverte_par")
  ouverteLe  DateTime  @default(now()) @map("ouverte_le")
  clotureeLe DateTime? @map("cloturee_le")
  clotureePar String?  @map("cloturee_par")

  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  etapes   ProcedureEtape[]

  @@index([statut, type])
  @@map("procedures")
}

/// Étape d'une procédure, avec le délai qui la sépare de la précédente.
model ProcedureEtape {
  id          String    @id @default(uuid())
  procedureId String    @map("procedure_id")
  ordre       Int
  code        String
  libelle     String
  attendu     String    @db.Text
  obligatoire Boolean   @default(true)

  /// Délai minimal, en jours, depuis l'étape précédente. Franchir une étape
  /// avant ce délai est le vice de forme le plus fréquent : l'application le
  /// refuse plutôt que de l'enregistrer.
  delaiMinJours Float   @default(0) @map("delai_min_jours")
  /// Délai au-delà duquel l'étape est en retard, s'il y a lieu.
  delaiMaxJours Float?  @map("delai_max_jours")
  motifDelai    String? @map("motif_delai") @db.Text

  faiteLe   DateTime? @map("faite_le")
  faitePar  String?   @map("faite_par")
  note      String?   @db.Text
  /// Preuve de remise : décharge signée, accusé de réception.
  preuve    String?   @db.Text

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId, ordre])
  @@map("procedure_etapes")
}

// ----------------------------------------------------
// BUDGET D'EFFECTIF ET DE MASSE SALARIALE
// ----------------------------------------------------

/// Budget annuel d'un service : postes ouverts et masse salariale prévue.
///
/// L'application savait dire ce qui avait été payé, jamais ce qui avait été
/// prévu. Le mot « budget » n'apparaissait nulle part dans le modèle. Cette
/// table donne le point de comparaison sans lequel un écart ne se voit pas.
///
/// La masse budgétée s'entend en coût employeur — brut plus charges patronales
/// — sur l'année : c'est ce que l'entreprise décaisse, et la seule grandeur
/// comparable au réalisé.
model BudgetEffectif {
  id          String @id @default(uuid())
  annee       Int
  departement String

  /// Postes budgétés, pourvus ou non.
  effectifBudgete        Int   @default(0) @map("effectif_budgete")
  /// Coût employeur annuel prévu, en FCFA.
  masseSalarialeBudgetee Float @default(0) @map("masse_salariale_budgetee")

  commentaire String?  @db.Text
  majPar      String?  @map("maj_par")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([annee, departement])
  @@index([annee])
  @@map("budgets_effectif")
}

/// Clé de scellement des signatures.
///
/// Le sceau atteste que le système a bien enregistré cette signature, sur ce
/// document, à cette date. Sans clé stable, un sceau ne survivrait pas à un
/// redémarrage et ne pourrait plus être vérifié — ce qui vaudrait moins que
/// pas de sceau du tout, puisqu'un certificat invérifiable se présente
/// néanmoins comme une preuve.
///
/// La clé se déclare de préférence dans l'environnement du serveur. À défaut,
/// elle est produite une fois et conservée ici : moins protégé qu'une variable
/// d'environnement, mais stable — et le certificat indique laquelle a servi.
model SigningKey {
  id            String   @id @default(uuid())
  keyId         String   @unique @map("key_id")
  publicKeyPem  String   @map("public_key_pem") @db.Text
  privateKeyPem String   @map("private_key_pem") @db.Text
  algorithm     String   @default("ed25519")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("signing_keys")
}

/// Décision de rémunération : embauche, augmentation, révision.
///
/// Une augmentation se décide, se motive et se date. Consignée ici, elle rend
/// la rémunération explicable — ce qu'un simple champ écrasé à chaque révision
/// ne permet pas.
model SalaryChange {
  id             String   @id @default(uuid())
  employeeId     String   @map("employee_id")
  amount         Float
  previousAmount Float?   @map("previous_amount")
  /// Date à laquelle le montant prend effet : elle peut précéder ou suivre la
  /// saisie, et c'est elle qui fait foi pour la paie.
  effectiveFrom  DateTime @map("effective_from")
  motif          String?  @db.Text
  decidePar      String?  @map("decide_par")
  createdAt      DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@map("salary_changes")
}

/// Délégation de validation pendant une absence.
///
/// Rien n'existait : quand le responsable qui valide est lui-même en congé, les
/// demandes s'arrêtent. C'est le reproche le plus courant fait aux SIRH en
/// exploitation, et le moins coûteux à corriger.
model DelegationValidation {
  id          String   @id @default(uuid())
  titulaireId String   @map("titulaire_id")
  suppleantId String   @map("suppleant_id")
  /// CONGES | DEPENSES | TOUT
  portee      String   @default("TOUT")
  debut       DateTime
  fin         DateTime
  motif       String?
  creePar     String?  @map("cree_par")
  revoqueeLe  DateTime? @map("revoquee_le")
  createdAt   DateTime @default(now()) @map("created_at")

  titulaire Employee @relation("Titulaire", fields: [titulaireId], references: [id], onDelete: Cascade)
  suppleant Employee @relation("Suppleant", fields: [suppleantId], references: [id], onDelete: Cascade)

  @@index([titulaireId, debut, fin])
  @@index([suppleantId])
  @@map("delegations_validation")
}

/// Situation d'un salarié sur une période : poste, service, rattachement,
/// nature de contrat, statut.
///
/// L'application ne connaissait que le présent. Elle savait qui occupe quel
/// poste aujourd'hui, jamais qui l'occupait au 1er janvier — ni sous quel
/// responsable, ni dans quel service. Impossible dès lors de reconstituer un
/// organigramme passé, de savoir quel poste occupait un salarié le jour d'un
/// accident, ou de comparer deux exercices autrement que de mémoire.
///
/// La fiche du salarié reste la situation courante : les écrans et les
/// requêtes existants n'ont pas changé. Cette table ajoute la profondeur de
/// temps, segment par segment.
///
/// `source` distingue ce qui a été observé de ce qui a été reconstitué : les
/// situations reprises lors de la mise en place valent ce que vaut l'hypothèse
/// « inchangé depuis l'embauche », et cela doit rester lisible.
model SituationEmployee {
  id         String    @id @default(uuid())
  employeeId String    @map("employee_id")

  effectiveFrom DateTime  @map("effective_from")
  /// Nul tant que la situation est en cours.
  effectiveTo   DateTime? @map("effective_to")

  positionTitle String?  @map("position_title")
  department    String?
  managerId     String?  @map("manager_id")
  contractType  String?  @map("contract_type")
  status        String?

  motif  String? @db.Text
  /// OBSERVEE (changement constaté par l'application) | REPRISE (reconstituée)
  source String  @default("OBSERVEE")

  createdAt DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
  @@map("situations_employe")
}

/// Décompte de fin de contrat arrêté.
///
/// Les courriers de rupture promettaient au salarié son solde de tout compte ;
/// l'application n'en produisait qu'un écran, recalculé à chaque affichage. Un
/// reçu que le salarié signe ne peut pas reposer sur un calcul mouvant : deux
/// impressions à un mois d'écart auraient porté des montants différents, sans
/// que rien ne le signale.
///
/// Cette table fige le décompte au jour où la RH l'arrête. Le reçu remis est
/// produit depuis ce détail conservé, jamais d'un nouveau calcul. Reprendre un
/// arrêté est possible — une erreur se corrige — mais révoque alors les reçus
/// déjà émis, dont le QR signalera l'invalidité.
model SoldeToutCompte {
  id         String   @id @default(uuid())
  /// Un seul arrêté par salarié : un départ n'a qu'un solde.
  employeeId String   @unique @map("employee_id")

  arreteLe   DateTime @default(now()) @map("arrete_le")
  arretePar  String?  @map("arrete_par")
  dateSortie DateTime @map("date_sortie")

  /// Net arrêté, en FCFA. Dupliqué hors du détail pour être interrogeable.
  netArrete  Float    @map("net_arrete")
  /// Décompte complet tel qu'il a été arrêté, conservé au caractère près.
  detail     String   @db.Text
  observations String? @db.Text

  /// Date de remise effective au salarié, quand elle est consignée.
  remisLe    DateTime? @map("remis_le")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("solde_tout_compte")
}

/// Titre ou habilitation à échéance d'un salarié.
///
/// Les prestataires disposaient d'un dossier de pièces daté et relancé avant
/// expiration ; les salariés n'avaient rien. Permis de conduire, aptitude
/// médicale, habilitation technique, titre de séjour : mêmes échéances, mêmes
/// conséquences. Un permis expiré au volant d'un véhicule de service engage
/// l'entreprise, et rien ne permettait de savoir qui était concerné.
///
/// Deux notions distinctes cohabitent ici, et les confondre ferait passer pour
/// acquis un document que personne n'a regardé :
///   - la **validité**, qui se déduit de `expireLe` ;
///   - le **contrôle**, porté par `statut` : une pièce déposée par le salarié
///     lui-même vaut A_CONTROLER jusqu'à ce que la RH la valide.
model PieceSalarie {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")

  /// PERMIS | APTITUDE | HABILITATION | CARTE_PRO | SEJOUR | AUTRE
  type       String
  reference  String?
  delivreeLe DateTime? @map("delivree_le")
  /// Déduite de la date de délivrance quand elle n'est pas fournie : une pièce
  /// sans échéance ne serait jamais relancée et paraîtrait valide indéfiniment.
  expireLe   DateTime? @map("expire_le")

  filePath   String?  @map("file_path")
  note       String?  @db.Text

  /// VALIDE | A_CONTROLER | REFUSEE
  statut       String    @default("A_CONTROLER")
  deposeePar   String?   @map("deposee_par")
  controleePar String?   @map("controlee_par")
  controleeLe  DateTime? @map("controlee_le")
  motifRefus   String?   @map("motif_refus") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type])
  @@index([expireLe])
  @@map("piece_salarie")
}
